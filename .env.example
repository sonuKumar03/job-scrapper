# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/job_scrapper

# Network & Concurrency
MAX_CONCURRENT_REQUESTS=3
MIN_REQUEST_DELAY_SECONDS=1.0
MAX_REQUEST_DELAY_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=30

# Optional Residential Proxy (leave blank for local IP)
HTTP_PROXY=
