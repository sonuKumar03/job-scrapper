# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/job_scrapper

# Network & Concurrency
MAX_CONCURRENT_REQUESTS=3
MIN_REQUEST_DELAY_SECONDS=1.0
MAX_REQUEST_DELAY_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=30

# Optional Residential Proxy (leave blank for local IP)
HTTP_PROXY=

# Execution: broker mode uses Redis Streams and a separate worker host.
SCRAPE_EXECUTOR=memory
SCRAPE_MAX_ACTIVE_RUNS=3
SCRAPE_MAX_QUEUED_RUNS=20
# SCRAPE_BROKER_URL=redis://localhost:6379/0
SCRAPE_BROKER_STREAM=job_scrapper.scrape.v1

# Loaded by the scraper and Alembic. Process environment values override this file.
